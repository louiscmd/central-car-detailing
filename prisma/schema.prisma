generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
  CLIENT
}

enum Platform {
  INSTAGRAM
  TIKTOK
  FACEBOOK
  YOUTUBE
}

enum PostType {
  POST
  REEL
  VIDEO
  STORY
  SHORT
}

enum AttachmentType {
  IMAGE
  VIDEO
  AUDIO
  FILE
}

enum SnapshotStatus {
  SUCCESS
  FAILED
  PARTIAL
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String
  role          Role      @default(USER)
  image         String?
  username      String?   @unique
  bio           String?   @db.Text
  avatarUrl     String?
  clients           Client[]
  sessions          Session[]
  accounts          Account[]
  territoryEntries  TerritoryEntry[]
  territorySettings TerritorySettings?
  pipelineStages    PipelineStage[]
  leads             Lead[]
  taskGroups        TaskGroup[]
  tasks             Task[]
  bizHubHistory     BizHubHistory[]
  bizHubWDays       BizHubWDay[]
  bizHubPrefs       BizHubPrefs?
  clientPortal      ClientPortal?
  sentMessages      ChatMessage[]   @relation("MessageSender")
  createdChannels   Channel[]       @relation("ChannelCreator")
  sentPartnerships      Partnership[] @relation("PartnershipInviter")
  receivedPartnerships  Partnership[] @relation("PartnershipInvitee")
  notifications         Notification[]
  pushSubscriptions     PushSubscription[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Client {
  id          String          @id @default(cuid())
  name        String
  notes       String?         @db.Text
  tags        String[]        @default([])
  isPaused    Boolean         @default(false)
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts         SocialAccount[]
  reports          Report[]
  revenueEstimate  RevenueEstimate?
  clientPortal     ClientPortal?
  channels         Channel[]
  chatMessages     ChatMessage[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@map("clients")
}

model SocialAccount {
  id          String          @id @default(cuid())
  platform    Platform
  username    String
  profileUrl  String
  displayName String?
  avatarUrl   String?
  clientId    String
  client      Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  snapshots   DailySnapshot[]
  posts       Post[]
  accessToken String?         @db.Text
  tokenExpiry DateTime?
  isPaused    Boolean         @default(false)
  lastScraped DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([clientId, platform])
  @@map("social_accounts")
}

model DailySnapshot {
  id             String        @id @default(cuid())
  accountId      String
  account        SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  date           DateTime      @db.Date
  followers      BigInt?
  following      BigInt?
  totalLikes     BigInt?
  postCount      Int?
  engagementRate Float?
  status         SnapshotStatus @default(SUCCESS)
  errorMessage   String?
  rawData        Json?
  createdAt      DateTime      @default(now())

  @@unique([accountId, date])
  @@index([accountId, date])
  @@map("daily_snapshots")
}

model Post {
  id          String               @id @default(cuid())
  accountId   String
  account     SocialAccount        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  externalId  String
  url         String
  type        PostType             @default(POST)
  caption     String?              @db.Text
  thumbnailUrl String?
  postedAt    DateTime
  metrics     PostMetricsHistory[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@unique([accountId, externalId])
  @@index([accountId, postedAt])
  @@map("posts")
}

model PostMetricsHistory {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  timestamp DateTime @default(now())
  views     BigInt?
  likes     BigInt?
  comments  BigInt?
  shares    BigInt?

  @@index([postId, timestamp])
  @@map("post_metrics_history")
}

model Report {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title       String
  month       Int
  year        Int
  data        Json
  pdfUrl      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([clientId, month, year])
  @@map("reports")
}

model RevenueEstimate {
  id               String   @id @default(cuid())
  clientId         String   @unique
  client           Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  industry         String   @default("restaurant")
  aov              Float    @default(0)
  monthlyCustomers Int      @default(0)
  profitMargin     Float    @default(0.20)
  conversionRate   Float    @default(0.02)
  followerGrowth   Float    @default(0)
  reachGrowth      Float    @default(0)
  engagementGrowth Float    @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("revenue_estimates")
}

model TerritoryEntry {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  city            String
  metro           String
  category        String
  totalBusinesses Int      @default(0)
  contacted       Int      @default(0)
  meetings        Int      @default(0)
  activeLeads     Int      @default(0)
  clientsWon      Int      @default(0)
  mrr             Float    @default(0)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, city, category])
  @@map("territory_entries")
}

enum LeadSource {
  INSTAGRAM_DM
  FACEBOOK_MESSAGE
  REFERRAL
  COLD_CALL
  EMAIL
  WALK_IN
  WEBSITE
  OTHER
}

enum ActivityType {
  CREATED
  STAGE_CHANGED
  NOTE_ADDED
  FOLLOW_UP_SCHEDULED
  FOLLOW_UP_COMPLETED
  DM_SENT
  CALLED
  EMAILED
  MEETING_HELD
  PROPOSAL_SENT
  CONTRACT_SENT
  WON
  LOST
}

enum FollowUpPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model PipelineStage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  position  Int
  color     String   @default("#6366f1")
  leads     Lead[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, position])
  @@map("pipeline_stages")
}

model Lead {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  stageId          String
  stage            PipelineStage @relation(fields: [stageId], references: [id])
  businessName     String
  category         String?
  city             String?
  contactName      String?
  instagram        String?
  phone            String?
  email            String?
  website          String?
  notes            String?       @db.Text
  source           LeadSource    @default(OTHER)
  score            Int           @default(0)
  expectedRetainer Float         @default(0)
  setupFee         Float         @default(0)
  closeProbability Float         @default(0.5)
  messageRead      Boolean       @default(false)
  facebookPsid     String?
  activities       LeadActivity[]
  followUps        FollowUp[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([userId, stageId])
  @@map("leads")
}

model LeadActivity {
  id        String       @id @default(cuid())
  leadId    String
  lead      Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      ActivityType
  note      String?      @db.Text
  metadata  Json?
  createdAt DateTime     @default(now())

  @@index([leadId, createdAt])
  @@map("lead_activities")
}

model FollowUp {
  id          String           @id @default(cuid())
  leadId      String
  lead        Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  dueDate     DateTime
  priority    FollowUpPriority @default(MEDIUM)
  note        String?          @db.Text
  completed   Boolean          @default(false)
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([leadId, dueDate])
  @@map("follow_ups")
}

model TaskGroup {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  position  Int      @default(0)
  tasks     Task[]
  createdAt DateTime @default(now())

  @@index([userId, position])
  @@map("task_groups")
}

model Task {
  id             String     @id @default(cuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId        String?
  group          TaskGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  title          String
  completed      Boolean    @default(false)
  position       Int        @default(0)
  dueDate        DateTime?
  scheduledStart DateTime?
  scheduledEnd   DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([userId, dueDate])
  @@index([userId, scheduledStart])
  @@map("tasks")
}

model ClientPortal {
  id        String   @id @default(cuid())
  userId    String   @unique
  clientId  String   @unique
  invitedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("client_portals")
}

model Channel {
  id          String        @id @default(cuid())
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name        String
  createdById String
  createdBy   User          @relation("ChannelCreator", fields: [createdById], references: [id])
  messages    ChatMessage[]
  createdAt   DateTime      @default(now())

  @@unique([clientId, name])
  @@index([clientId])
  @@map("channels")
}

model ChatMessage {
  id          String       @id @default(cuid())
  channelId   String?
  channel     Channel?     @relation(fields: [channelId], references: [id], onDelete: Cascade)
  clientId    String
  client      Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User         @relation("MessageSender", fields: [senderId], references: [id])
  content     String?      @db.Text
  attachments Attachment[]
  read        Boolean      @default(false)
  createdAt   DateTime     @default(now())

  @@index([channelId, createdAt])
  @@index([clientId, createdAt])
  @@map("chat_messages")
}

model Attachment {
  id        String         @id @default(cuid())
  messageId String
  message   ChatMessage    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  url       String
  type      AttachmentType
  filename  String
  size      Int
  createdAt DateTime       @default(now())

  @@map("attachments")
}

model BizHubHistory {
  id        String   @id @default(cuid())
  userId    String
  year      Int
  months    Json
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year])
  @@map("bizhub_history")
}

model BizHubWDay {
  id     String @id @default(cuid())
  userId String
  date   String
  checks Json
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("bizhub_wday")
}

model BizHubPrefs {
  id       String @id @default(cuid())
  userId   String @unique
  currency String @default("EUR")
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("bizhub_prefs")
}

model TerritorySettings {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  country          String   @default("Poland")
  activeCategories String[] @default([])
  excludedCities   String[] @default([])
  customMetros     Json     @default("[]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("territory_settings")
}

enum PartnershipStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum NotificationType {
  PARTNERSHIP_INVITE
  PARTNERSHIP_ACCEPTED
  PARTNERSHIP_DECLINED
  NEW_REPORT
  NEW_MESSAGE
}

model Partnership {
  id              String            @id @default(cuid())
  inviterId       String
  inviter         User              @relation("PartnershipInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  inviteeId       String
  invitee         User              @relation("PartnershipInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)
  status          PartnershipStatus @default(PENDING)
  linkedClientId  String?
  message         String?           @db.Text
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([inviterId, inviteeId])
  @@index([inviteeId, status])
  @@map("partnerships")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String?
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read, createdAt])
  @@map("notifications")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscriptions")
}
