generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum Platform {
  INSTAGRAM
  TIKTOK
  FACEBOOK
  YOUTUBE
}

enum PostType {
  POST
  REEL
  VIDEO
  STORY
  SHORT
}

enum SnapshotStatus {
  SUCCESS
  FAILED
  PARTIAL
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String
  role          Role      @default(USER)
  image         String?
  clients           Client[]
  sessions          Session[]
  accounts          Account[]
  territoryEntries  TerritoryEntry[]
  territorySettings TerritorySettings?
  pipelineStages    PipelineStage[]
  leads             Lead[]
  taskGroups        TaskGroup[]
  tasks             Task[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Client {
  id          String          @id @default(cuid())
  name        String
  notes       String?         @db.Text
  tags        String[]        @default([])
  isPaused    Boolean         @default(false)
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts         SocialAccount[]
  reports          Report[]
  revenueEstimate  RevenueEstimate?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@map("clients")
}

model SocialAccount {
  id          String          @id @default(cuid())
  platform    Platform
  username    String
  profileUrl  String
  displayName String?
  avatarUrl   String?
  clientId    String
  client      Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  snapshots   DailySnapshot[]
  posts       Post[]
  accessToken String?         @db.Text
  tokenExpiry DateTime?
  isPaused    Boolean         @default(false)
  lastScraped DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([clientId, platform])
  @@map("social_accounts")
}

model DailySnapshot {
  id             String        @id @default(cuid())
  accountId      String
  account        SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  date           DateTime      @db.Date
  followers      BigInt?
  following      BigInt?
  totalLikes     BigInt?
  postCount      Int?
  engagementRate Float?
  status         SnapshotStatus @default(SUCCESS)
  errorMessage   String?
  rawData        Json?
  createdAt      DateTime      @default(now())

  @@unique([accountId, date])
  @@index([accountId, date])
  @@map("daily_snapshots")
}

model Post {
  id          String               @id @default(cuid())
  accountId   String
  account     SocialAccount        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  externalId  String
  url         String
  type        PostType             @default(POST)
  caption     String?              @db.Text
  thumbnailUrl String?
  postedAt    DateTime
  metrics     PostMetricsHistory[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@unique([accountId, externalId])
  @@index([accountId, postedAt])
  @@map("posts")
}

model PostMetricsHistory {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  timestamp DateTime @default(now())
  views     BigInt?
  likes     BigInt?
  comments  BigInt?
  shares    BigInt?

  @@index([postId, timestamp])
  @@map("post_metrics_history")
}

model Report {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title       String
  month       Int
  year        Int
  data        Json
  pdfUrl      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([clientId, month, year])
  @@map("reports")
}

model RevenueEstimate {
  id               String   @id @default(cuid())
  clientId         String   @unique
  client           Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  industry         String   @default("restaurant")
  aov              Float    @default(0)
  monthlyCustomers Int      @default(0)
  profitMargin     Float    @default(0.20)
  conversionRate   Float    @default(0.02)
  followerGrowth   Float    @default(0)
  reachGrowth      Float    @default(0)
  engagementGrowth Float    @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("revenue_estimates")
}

model TerritoryEntry {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  city            String
  metro           String
  category        String
  totalBusinesses Int      @default(0)
  contacted       Int      @default(0)
  meetings        Int      @default(0)
  activeLeads     Int      @default(0)
  clientsWon      Int      @default(0)
  mrr             Float    @default(0)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, city, category])
  @@map("territory_entries")
}

enum LeadSource {
  INSTAGRAM_DM
  FACEBOOK_MESSAGE
  REFERRAL
  COLD_CALL
  EMAIL
  WALK_IN
  WEBSITE
  OTHER
}

enum ActivityType {
  CREATED
  STAGE_CHANGED
  NOTE_ADDED
  FOLLOW_UP_SCHEDULED
  FOLLOW_UP_COMPLETED
  DM_SENT
  CALLED
  EMAILED
  MEETING_HELD
  PROPOSAL_SENT
  CONTRACT_SENT
  WON
  LOST
}

enum FollowUpPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model PipelineStage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  position  Int
  color     String   @default("#6366f1")
  leads     Lead[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, position])
  @@map("pipeline_stages")
}

model Lead {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  stageId          String
  stage            PipelineStage @relation(fields: [stageId], references: [id])
  businessName     String
  category         String?
  city             String?
  contactName      String?
  instagram        String?
  phone            String?
  email            String?
  website          String?
  notes            String?       @db.Text
  source           LeadSource    @default(OTHER)
  score            Int           @default(0)
  expectedRetainer Float         @default(0)
  setupFee         Float         @default(0)
  closeProbability Float         @default(0.5)
  activities       LeadActivity[]
  followUps        FollowUp[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([userId, stageId])
  @@map("leads")
}

model LeadActivity {
  id        String       @id @default(cuid())
  leadId    String
  lead      Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      ActivityType
  note      String?      @db.Text
  metadata  Json?
  createdAt DateTime     @default(now())

  @@index([leadId, createdAt])
  @@map("lead_activities")
}

model FollowUp {
  id          String           @id @default(cuid())
  leadId      String
  lead        Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  dueDate     DateTime
  priority    FollowUpPriority @default(MEDIUM)
  note        String?          @db.Text
  completed   Boolean          @default(false)
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([leadId, dueDate])
  @@map("follow_ups")
}

model TaskGroup {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  position  Int      @default(0)
  tasks     Task[]
  createdAt DateTime @default(now())

  @@index([userId, position])
  @@map("task_groups")
}

model Task {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId   String?
  group     TaskGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  title     String
  completed Boolean    @default(false)
  position  Int        @default(0)
  dueDate   DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId, dueDate])
  @@map("tasks")
}

model TerritorySettings {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  country          String   @default("Poland")
  activeCategories String[] @default([])
  excludedCities   String[] @default([])
  customMetros     Json     @default("[]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("territory_settings")
}
